# Copy to .env. Defaults run fully simulated and free.

# --- Calls ---
LIVE_MODE=false                 # true = real Bolna calls (spends credit)
BOLNA_API_KEY=
BOLNA_AGENT_ID=                 # from scripts/create_agent.py
BOLNA_FROM_NUMBER=              # optional; Bolna default number if empty
MAX_LIVE_CALLS_PER_SEARCH=4     # hard cap on paid calls per search (fallback numbers count)
LIVE_CONCURRENCY=2              # calls at once; match concurrency.max from scripts/check_account.py
# FACILITIES_FILE=data/facilities_live.json   # live: only verified numbers (trial accounts)

# --- Decisions: jev | clef | mock (falls back down the chain) ---
# Mock answers are never trusted to confirm availability on live calls.
DECISION_BACKEND=mock
TYPESAFE_API_KEY=               # console.typesafe.ai/keys (Jev early access)
CF_ACCOUNT_ID=                  # Cloudflare Workers AI, for Clef
CF_API_TOKEN=
CLEF_MODEL=clef-flash

# --- Search ---
MIN_CONFIRMED=2                 # stop calling once this many confirm and units are covered
SEARCH_DEADLINE_S=240           # no new call waves after this
SIM_SPEED=1                     # 2-3 makes the simulated demo snappier
